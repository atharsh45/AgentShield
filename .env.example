# Development-only examples. Replace both credentials with unique random secrets for deployment.
AGENTSHIELD_ENV=development
AGENTSHIELD_API_KEY=dev-only-change-me
AGENTSHIELD_ADMIN_API_KEY=dev-admin-only-change-me
AGENTSHIELD_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
# Local Ollama integration
OLLAMA_CHAT_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b
# MCP adapter gateway settings
AGENTSHIELD_URL=http://127.0.0.1:8000
# Optional database path
# AGENTSHIELD_DB_PATH=./data/agentshield_audit.sqlite3
# Next.js dashboard can override API URL via frontend_nextjs/.env.local:
# NEXT_PUBLIC_AGENTSHIELD_API=http://127.0.0.1:8000
